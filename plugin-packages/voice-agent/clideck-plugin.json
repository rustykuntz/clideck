{
  "id": "voice-agent",
  "name": "Voice Agent",
  "version": "0.3.0",
  "apiVersion": 1,
  "enabledByDefault": false,
  "description": "Talk naturally with your CliDeck session. Ask for a recap, choose the next step, or ask your agent to do something. Voice pauses when you switch away. Phone calls are optional.",
  "icon": "waveform",
  "commands": [
    {
      "name": "setup",
      "description": "Check browser voice setup and optional phone setup. Check verifies OpenAI access without starting audio.",
      "usage": "voice-agent/setup [check]"
    },
    {
      "name": "start",
      "description": "Start an authorized phone call from a JSON brief on stdin; reuse requestId on retry.",
      "usage": "voice-agent/start --stdin"
    },
    {
      "name": "status",
      "description": "Read your calls, live transcript and pending agent questions.",
      "usage": "voice-agent/status [call-id]"
    },
    {
      "name": "steer",
      "description": "Send directions or an explicit delegation answer to your call using JSON on stdin.",
      "usage": "voice-agent/steer <call-id> --stdin"
    },
    {
      "name": "reply",
      "description": "Send a concise answer or progress update for a spoken user request.",
      "usage": "voice-agent/reply <request-id> --stdin"
    },
    {
      "name": "key",
      "description": "Send one telephone keypad key (0-9, A-D, * or #) to your call.",
      "usage": "voice-agent/key <call-id> <key>"
    },
    {
      "name": "stop",
      "description": "Hang up your call; repeated stops never redial.",
      "usage": "voice-agent/stop <call-id>"
    }
  ],
  "settings": [
    {
      "key": "talk-to-sessions",
      "label": "Talk to sessions",
      "type": "toggle",
      "default": true,
      "description": "Show the Voice Agent icon in session headers. Click it to talk. Microphone and sound pause when you leave the session. Turning this off stops session voice."
    },
    {
      "key": "openai-key",
      "label": "OpenAI API key",
      "type": "secret",
      "default": "",
      "description": "Your OpenAI API key for voice. Stored on the CliDeck server; never sent to the browser."
    },
    {
